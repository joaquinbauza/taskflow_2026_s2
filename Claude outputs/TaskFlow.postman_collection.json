              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "members"
              ]
            },
            "description": "US-11 AC2 (especificacion): los miembros se agregan indicando su email; si el usuario existe, la respuesta debe ser 201.\nRequiere haber corrido antes 'Crear proyecto valido' (usa {{projectId}}).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@test.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('US-11 AC2: agregar un miembro con email valido debe devolver 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[BUG?] Listar proyectos como miembro de uno archivado (Bob)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBob}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            },
            "description": "US-04 AC2 (especificacion): los proyectos archivados NO aparecen en el listado, sea el usuario owner o miembro. Bob es miembro (no owner) del proyecto semilla 'Migracion legacy', que esta archivado.\nRequiere haber corrido antes 'Login Bob (usuario semilla)' y no haber corrido 'npm run db:reset' luego del seed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('US-04 AC2: un proyecto archivado no debe aparecer aunque el usuario sea miembro', () => {",
                  "    const projects = pm.response.json();",
                  "    const archivado = projects.find(p => p.name === 'Migraci\\u00f3n legacy');",
                  "    pm.expect(archivado, 'Migraci\\u00f3n legacy no deberia estar en la lista').to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
