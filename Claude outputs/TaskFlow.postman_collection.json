    {
      "name": "02 - Tasks",
      "item": [
        {
          "name": "Crear tarea base (sin forzar status)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "description": "Tarea limpia (status TODO garantizado) para usar en el test de transicion. Requiere {{projectId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarea base QA\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crear tarea devuelve 201', () => pm.response.to.have.status(201));",
                  "const task = pm.response.json();",
                  "if (task.id) pm.environment.set('taskId', task.id);",
                  "pm.test('La tarea nueva arranca en TODO', () => pm.expect(task.status).to.eql('TODO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "[BUG?] Crear tarea forzando status en el body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "description": "US-05 AC3 (especificacion): el estado inicial de toda tarea es SIEMPRE TODO, aunque la solicitud incluya otro estado. Hay un escenario BDD explicito para este caso.\nEsperado: 201 y status 'TODO' en la respuesta, sin importar el status enviado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tarea forzada DONE\",\n  \"status\": \"DONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('US-05 AC3: el status inicial debe ser TODO sin importar el body enviado', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const task = pm.response.json();",
                  "    pm.expect(task.status).to.eql('TODO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "[BUG?] Transicion directa TODO -> DONE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
