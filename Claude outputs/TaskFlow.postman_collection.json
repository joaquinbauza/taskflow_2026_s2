              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"US-03 AC1: nombre de 2 caracteres debe rechazarse (400)\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
