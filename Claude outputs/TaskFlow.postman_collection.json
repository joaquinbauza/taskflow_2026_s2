            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "US-06 AC2 (especificacion): NO esta permitido ir de TODO directamente a DONE. Escenario BDD explicito: 'No se puede mover de TODO a DONE directamente' -> 422.\nUsa {{taskId}} de 'Crear tarea base (sin forzar status)', que arranca en TODO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('US-06 AC2: TODO -> DONE directo debe rechazarse con 422', () => {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cargar dueDate",
