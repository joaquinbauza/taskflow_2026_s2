              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "Paso 1 del test de zona horaria (US-16 AC3). Seguir con 'Verificar dueDate'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDate\": \"2026-09-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualizar dueDate devuelve 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[BUG?] Verificar dueDate (posible bug de zona horaria)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            },
            "description": "US-16 AC3 (especificacion): la fecha que se devuelve es siempre la misma que se cargo, sin importar la zona horaria del servidor ni la del cliente. Hay un escenario BDD explicito con cliente en UTC-3 (la zona horaria de Uruguay).\nEsperado: dueDate == '2026-09-15'. Si el servidor corre en una zona horaria negativa (UTC-3, por ejemplo), formatDueDate podria devolver '2026-09-14' por una mezcla de Date UTC / getters locales en server/src/lib/ids.ts."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('US-16 AC3: dueDate debe volver igual a como se cargo (2026-09-15)', () => {",
                  "    const task = pm.response.json();",
                  "    pm.expect(task.dueDate).to.eql('2026-09-15');",
                  "});"
                ]
              }
            }
          ]
        }
