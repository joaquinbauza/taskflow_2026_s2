{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow — gestor de tareas colaborativo. Proyecto del curso de Testing y Calidad de Software.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:setup",
    "db:reset": "npm --prefix server run db:reset",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage",
    "test:unit": "npm --prefix server run test:unit",
    "test:contract": "npm --prefix server run test:contract",
    "test:bugs": "npm --prefix server run test:bugs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm --prefix server run lint",
    "postinstall": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "concurrently": "9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
